doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet" href="/styles.css")

  body
    main.container
      h1 Users

      .cards
        each user in users
          article.card
            h2= user.name
            p= user.email

            a.button(href=`/users/${user.id}`) View user
