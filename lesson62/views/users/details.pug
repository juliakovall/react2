doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet" href="/styles.css")

  body
    main.container
      a.back-link(href="/users") ← Back to users

      article.details
        h1= user.name
        p
          strong ID:
          |  #{user.id}

        p
          strong Email:
          |  #{user.email}
