<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body>
    <main class="container">
      <a class="back-link" href="/articles"> ← Back to articles </a>

      <article class="details">
        <h1><%= article.title %></h1>

        <p>
          <strong>ID:</strong>
          <%= article.id %>
        </p>

        <p><%= article.content %></p>
      </article>
    </main>
  </body>
</html>
